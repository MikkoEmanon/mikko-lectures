{
  "title": "Research Methodology with R",
  "description": "Quantitative and qualitative analysis using R for social sciences and linguistics.",
  "sessions": [
    {
      "title": "Session 1: Introduction to R and RStudio",
      "lectures": [
        {
          "title": "Setting Up Your Environment",
          "content": [
            {
              "type": "heading",
              "text": "R Basics"
            },
            {
              "type": "text",
              "text": "Data types, vectors, and basic syntax."
            },
            {
              "type": "image",
              "src": "assets/research-methodology-with-r/session-1-rstudio.png",
              "alt": "RStudio Interface"
            }
          ]
        }
      ]
    },
    {
      "title": "Session 2: Data Import and Tidy Data",
      "lectures": [
        {
          "title": "Reading CSV, Excel, and SPSS Files",
          "content": [
            {
              "type": "heading",
              "text": "Tidyverse and readr"
            },
            {
              "type": "text",
              "text": "Principles of tidy data: one variable per column, one observation per row."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 3: Data Wrangling with dplyr",
      "lectures": [
        {
          "title": "Filter, Select, Mutate, Summarize",
          "content": [
            {
              "type": "heading",
              "text": "Core Verbs of dplyr"
            },
            {
              "type": "text",
              "text": "Transforming and reshaping datasets efficiently."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 4: Visualization with ggplot2",
      "lectures": [
        {
          "title": "Grammar of Graphics",
          "content": [
            {
              "type": "heading",
              "text": "Building Plots Layer by Layer"
            },
            {
              "type": "text",
              "text": "Scatter plots, histograms, boxplots for exploratory analysis."
            },
            {
              "type": "image",
              "src": "assets/research-methodology-with-r/session-4-ggplot.png",
              "alt": "ggplot2 Output Example"
            }
          ]
        }
      ]
    },
    {
      "title": "Session 5: Descriptive Statistics",
      "lectures": [
        {
          "title": "Measures of Central Tendency and Dispersion",
          "content": [
            {
              "type": "heading",
              "text": "Mean, Median, SD, IQR in R"
            },
            {
              "type": "text",
              "text": "Summarizing distributions with base R and psych package."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 6: Inferential Statistics I – T-tests and ANOVA",
      "lectures": [
        {
          "title": "Comparing Group Means",
          "content": [
            {
              "type": "heading",
              "text": "Parametric Tests in R"
            },
            {
              "type": "text",
              "text": "Assumptions, effect sizes, and post-hoc tests."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 7: Correlation and Linear Regression",
      "lectures": [
        {
          "title": "Modeling Relationships",
          "content": [
            {
              "type": "heading",
              "text": "lm() Function and Interpretation"
            },
            {
              "type": "text",
              "text": "Residuals, R-squared, and model diagnostics."
            },
            {
              "type": "image",
              "src": "assets/research-methodology-with-r/session-7-regression.png",
              "alt": "Regression Line Plot"
            }
          ]
        }
      ]
    },
    {
      "title": "Session 8: Multiple Regression",
      "lectures": [
        {
          "title": "Adding Predictors",
          "content": [
            {
              "type": "heading",
              "text": "Multivariate Models"
            },
            {
              "type": "text",
              "text": "Collinearity, interaction terms, and model selection."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 9: Logistic Regression",
      "lectures": [
        {
          "title": "Predicting Categorical Outcomes",
          "content": [
            {
              "type": "heading",
              "text": "Binary and Multinomial Models"
            },
            {
              "type": "text",
              "text": "Odds ratios and classification accuracy."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 10: Reliability and Scale Construction",
      "lectures": [
        {
          "title": "Cronbach’s Alpha and Factor Analysis",
          "content": [
            {
              "type": "heading",
              "text": "Validating Survey Instruments"
            },
            {
              "type": "text",
              "text": "Using psych and lavaan for psychometric analysis."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 11: Text as Data – Introduction to quanteda",
      "lectures": [
        {
          "title": "Corpus Analysis in R",
          "content": [
            {
              "type": "heading",
              "text": "Tokenization and Document-Term Matrices"
            },
            {
              "type": "text",
              "text": "Frequency analysis, KWIC, and basic sentiment scoring."
            },
            {
              "type": "image",
              "src": "assets/research-methodology-with-r/session-11-wordcloud.png",
              "alt": "Word Cloud from Corpus"
            }
          ]
        }
      ]
    },
    {
      "title": "Session 12: Topic Modeling with LDA",
      "lectures": [
        {
          "title": "Uncovering Latent Themes",
          "content": [
            {
              "type": "heading",
              "text": "Latent Dirichlet Allocation"
            },
            {
              "type": "text",
              "text": "Using topicmodels or stm packages."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 13: Mixed-Methods Integration",
      "lectures": [
        {
          "title": "Combining Quant and Qual",
          "content": [
            {
              "type": "heading",
              "text": "Triangulation Strategies"
            },
            {
              "type": "text",
              "text": "Using R for coding qualitative themes and linking to survey data."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 14: Reproducible Research with R Markdown",
      "lectures": [
        {
          "title": "Dynamic Reporting",
          "content": [
            {
              "type": "heading",
              "text": "From Code to Publication"
            },
            {
              "type": "text",
              "text": "Embedding results, figures, and narrative in a single document."
            }
          ]
        }
      ]
    },
    {
      "title": "Session 15: Final Project – Data Analysis Portfolio",
      "lectures": [
        {
          "title": "Presenting Your Findings",
          "content": [
            {
              "type": "heading",
              "text": "End-to-End Analysis"
            },
            {
              "type": "text",
              "text": "Students analyze their own dataset and produce a report in R Markdown."
            }
          ]
        }
      ]
    }
  ]
}
